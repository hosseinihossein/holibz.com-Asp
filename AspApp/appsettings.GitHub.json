    "LibraryCollection": "Library"
  },

  "Postgres": {
    "ConnectionString": {
      "Identity": "Host=postgres;Database=IdentityDb;Username=postgres;Password=Password;GssEncryptionMode=Disable;",
      "DataProtection": "Host=postgres;Database=DataProtectionDb;Username=postgres;Password=Password;GssEncryptionMode=Disable;",
      "Library": "Host=postgres;Database=LibraryDb;Username=postgres;Password=Password;GssEncryptionMode=Disable;",
      "OpenIddict": "Host=postgres;Database=OpenIddictDb;Username=postgres;Password=Password;GssEncryptionMode=Disable;"
    }
  },
  
  "GitHubClientId": "YourClientId",
  "GitHubClientSecret": "YourClientSecret",
  
  "GoogleClientId": "yourClientId.apps.googleusercontent.com",
  "GoogleClientSecret": "Your-Client-Secret",

  "Identity": {
    "AdminUserName": "adminUserName",
    "AdminPassword": "adminPassword",
    "AdminEmail": "adminEmail@email.com",
    "AdminRoleName": "Identity_Admins"
  },

  "EmailSender": {
    "Address": "yourEmailAddress@email.com",
