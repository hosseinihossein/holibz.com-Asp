{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MainDomainName": "https://holibz.com",

  "Turnstile": {
    "Enabled": false,
    "SecretKey": "your-secret-key"
  },

  "MongoDb": {
    "ConnectionString": "mongodb://mongodb:27017",
    
    "UserAccountDb": "UserAccount_Db",
    "ProfileCollection": "Profile",

